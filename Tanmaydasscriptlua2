-- [SECTION 7: LOCAL CHARACTER MODIFICATIONS & INFINITE ENERGY]
RunService.RenderStepped:Connect(function()
    pcall(function()
        local Char = LocalPlayer.Character
        if Char and Char:FindFirstChild("Humanoid") then
            Char.Humanoid.WalkSpeed = getgenv().SolaraHub.WalkSpeed
            Char.Humanoid.JumpPower = getgenv().SolaraHub.JumpPower
            
            -- Infinite Energy enforcement
            if getgenv().SolaraHub.InfiniteEnergy and Char:FindFirstChild("Energy") then
                Char.Energy.Value = Char.Energy.MaxValue
            end
            
            -- No Clip Execution
            if getgenv().SolaraHub.NoClip then
                for _, part in pairs(Char:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end
    end)
end)

-- [SECTION 7: INFINITE GEPPO (Sky Jump)]
UserInputService.JumpRequest:Connect(function()
    pcall(function()
        if getgenv().SolaraHub.InfiniteGeppo then
            local Char = LocalPlayer.Character
            if Char and Char:FindFirstChild("Humanoid") then
                Char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)
end)

-- [SECTION 1 & 2: MOB MOBILIZATION & FAST ATTACK ENGINE]
task.spawn(function()
    while task.wait() do
        pcall(function()
            -- Bring Mobs Engine
            if getgenv().SolaraHub.BringMob then
                local pPos = LocalPlayer.Character.HumanoidRootPart.Position
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if enemy:FindFirstChild("HumanoidRootPart") and (enemy.HumanoidRootPart.Position - pPos).Magnitude < 300 then
                        enemy.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5)
                    end
                end
            end
            -- Fast Attack Engine
            if getgenv().SolaraHub.FastAttack then
                local Tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if Tool and Tool:FindFirstChild("Click") then Tool.Click:FireServer() end
            end
        end)
    end
end)

-- [SECTION 4: FRUIT MANIPULATION (Auto Bring & Store)]
task.spawn(function()
    while task.wait(2) do
        if getgenv().SolaraHub.AutoBringFruit then
            pcall(function()
                for _, item in pairs(workspace:GetChildren()) do
                    if item:IsA("Tool") and string.find(item.Name, "Fruit") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = item.Handle.CFrame
                        task.wait(0.5)
                    end
                end
            end)
        end
        if getgenv().SolaraHub.AutoStoreFruit then
            pcall(function()
                -- Remotes change per update, maps structurally to storage remote
                game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StoreFruit")
            end)
        end
    end
end)

