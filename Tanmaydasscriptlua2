-- ========================================================================================
-- UNIVERSAL BUTTON CREATOR FUNCTION
-- ========================================================================================
local function CreateButton(text, clickCallback)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -10, 0, 45)
    Button.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    Button.Text = text .. " [OFF]"
    Button.TextColor3 = Color3.fromRGB(255, 100, 100) -- Starts Red for OFF
    Button.TextSize = 14
    Button.Font = Enum.Font.SourceSansSemibold
    Button.Parent = Scroll

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = Button

    local active = false
    Button.MouseButton1Click:Connect(function()
        active = not active
        if active then
            Button.BackgroundColor3 = Color3.fromRGB(50, 80, 50)
            Button.TextColor3 = Color3.fromRGB(100, 255, 100) -- Green for ON
            Button.Text = text .. " [ON]"
        else
            Button.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            Button.TextColor3 = Color3.fromRGB(255, 100, 100) -- Red for OFF
            Button.Text = text .. " [OFF]"
        end
        clickCallback(active)
    end)
end

