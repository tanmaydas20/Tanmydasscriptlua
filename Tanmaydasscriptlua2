-- Universal Category Label Generator
local function CreateHeader(text)
    local H = Instance.new("TextLabel")
    H.Size = UDim2.new(1, -10, 0, 25)
    H.BackgroundTransparency = 1
    H.Text = "--- " .. string.upper(text) .. " ---"
    H.TextColor3 = Color3.fromRGB(255, 200, 50)
    H.TextSize = 13
    H.Font = Enum.Font.SourceSansBold
    H.Parent = Scroll
end

-- Universal Interactive Toggle Button Generator
local function CreateToggle(text, globalVarName, callback)
    local B = Instance.new("TextButton")
    B.Size = UDim2.new(1, -10, 0, 38)
    B.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    B.Text = text .. " [OFF]"
    B.TextColor3 = Color3.fromRGB(255, 120, 120)
    B.TextSize = 13
    B.Font = Enum.Font.SourceSansSemibold
    B.Parent = Scroll

    local BC = Instance.new("UICorner")
    BC.CornerRadius = UDim.new(0, 5)
    BC.Parent = B

    B.MouseButton1Click:Connect(function()
        _G[globalVarName] = not _G[globalVarName]
        if _G[globalVarName] then
            B.BackgroundColor3 = Color3.fromRGB(45, 75, 45)
            B.TextColor3 = Color3.fromRGB(120, 255, 120)
            B.Text = text .. " [ON]"
        else
            B.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            B.TextColor3 = Color3.fromRGB(255, 120, 120)
            B.Text = text .. " [OFF]"
        end
        if callback then callback(_G[globalVarName]) end
    end)
end

-- Universal Text Input Box for Character Speed / Jump Settings
local function CreateInputBox(placeholderText, globalVarName)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, -10, 0, 40)
    Container.BackgroundTransparency = 1
    Container.Parent = Scroll

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.5, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = placeholderText .. ":"
    Label.TextColor3 = Color3.fromRGB(220, 220, 220)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.TextSize = 13
    Label.Font = Enum.Font.SourceSans
    Label.Parent = Container

    local Box = Instance.new("TextBox")
    Box.Size = UDim2.new(0.45, 0, 0.8, 0)
    Box.Position = UDim2.new(0.55, 0, 0.1, 0)
    Box.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Box.TextColor3 = Color3.fromRGB(255, 255, 255)
    Box.Text = tostring(_G[globalVarName])
    Box.TextSize = 13
    Box.Font = Enum.Font.SourceSansBold
    Box.Parent = Container

    local BoxCorner = Instance.new("UICorner")
    BoxCorner.CornerRadius = UDim.new(0, 4)
    BoxCorner.Parent = Box

    Box.FocusLost:Connect(function(enterPressed)
        local val = tonumber(Box.Text)
        if val then _G[globalVarName] = val else Box.Text = tostring(_G[globalVarName]) end
    end)
end

