-- Custom Category Sub-header Generator
local function AddCategoryHeader(titleText)
    local HLabel = Instance.new("TextLabel")
    HLabel.Size = UDim2.new(1, -10, 0, 30)
    HLabel.BackgroundTransparency = 1
    HLabel.Text = "─── " .. string.upper(titleText) .. " ───"
    HLabel.TextColor3 = Color3.fromRGB(0, 180, 255)
    HLabel.TextSize = 12
