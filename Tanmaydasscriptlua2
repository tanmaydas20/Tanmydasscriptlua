-- Fast Attack Action Thread
task.spawn(function()
    while task.wait() do
        if _G.FastAttack then
            pcall(function()
                local tool = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool and tool:FindFirstChild("Click") then
                    tool.Click:FireServer()
                end
            end)
        end
    end
end)

-- Beli Chest Teleport Thread
task.spawn(function()
    while task.wait(0.5) do
        if _G.BeliFarm then
            pcall(function()
                for _, chest in pairs(workspace:GetChildren()) do
                    if string.find(chest.Name, "Chest") and chest:FindFirstChild("TouchInterest") then
                        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = chest.CFrame
                        task.wait(0.2)
                    end
                end
            end)
        end
    end
end)

-- Fruit Magnet Teleport Thread
task.spawn(function()
    while task.wait(2) do
        if _G.FruitBring then
            pcall(function()
                for _, item in pairs(workspace:GetChildren()) do
                    if item:IsA("Tool") and string.find(item.Name, "Fruit") then
                        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = item.Handle.CFrame
                        task.wait(0.5)
                    end
                end
            end)
        end
    end
end)

