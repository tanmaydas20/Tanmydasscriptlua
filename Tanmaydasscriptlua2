-- Premium Toggle Creation Engine (Dynamic Verification State)
local function AddFeatureToggle(labelName, targetGlobalVar)
    local TButton = Instance.new("TextButton")
    TButton.Size = UDim2.new(1, -10, 0, 38)
    TButton.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    TButton.Text = "  " .. labelName .. " : [OFF]"
    TButton.TextColor3 = Color3.fromRGB(240, 90, 90)
    TButton.TextSize = 13
    TButton.Font = Enum.Font.SourceSansSemibold
    TButton.TextXAlignment = Enum.TextXAlignment.Left
    TButton.Parent = Scroll

    local TCorner = Instance.new("UICorner")
    TCorner.CornerRadius = UDim.new(0, 6)
    TCorner.Parent = TButton

    TButton.MouseButton1Click:Connect(function()
        _G[targetGlobalVar] = not _G[targetGlobalVar]
        if _G[targetGlobalVar] then
            TButton.BackgroundColor3 = Color3.fromRGB(34, 60, 34)
            TButton.TextColor3 = Color3.fromRGB(100, 240, 100)
            TButton.Text = "  " .. labelName .. " : [ON]"
        else
            TButton.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
            TButton.TextColor3 = Color3.fromRGB(240, 90, 90)
            TButton.Text = "  " .. labelName .. " : [OFF]"
        end
    end)
end

-- Value Modification Input Field Construction
local function AddValueSliderInput(labelText, targetGlobalVar)
    local Panel = Instance.new("Frame")
    Panel.Size = UDim2.new(1, -10, 0, 40)
    Panel.BackgroundTransparency = 1
    Panel.Parent = Scroll

    local PLabel = Instance.new("TextLabel")
    PLabel.Size = UDim2.new(0.5, 0, 1, 0)
    PLabel.BackgroundTransparency = 1
    PLabel.Text = "  " .. labelText
    PLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    PLabel.TextSize = 13
    PLabel.Font = Enum.Font.SourceSans
    PLabel.TextXAlignment = Enum.TextXAlignment.Left
    PLabel.Parent = Panel

    local PBox = Instance.new("TextBox")
    PBox.Size = UDim2.new(0.4, 0, 0.8, 0)
    PBox.Position = UDim2.new(0.6, 0, 0.1, 0)
    PBox.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    PBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    PBox.Text = tostring(_G[targetGlobalVar])
    PBox.TextSize = 13
    PBox.Font = Enum.Font.SourceSansBold
    PBox.Parent = Panel

    local PBoxCorner = Instance.new("UICorner")
    PBoxCorner.CornerRadius = UDim.new(0, 4)
    PBoxCorner.Parent = PBox

    PBox.FocusLost:Connect(function()
        local convertedNum = tonumber(PBox.Text)
        if convertedNum then
            _G[targetGlobalVar] = convertedNum
        else
            PBox.Text = tostring(_G[targetGlobalVar])
        end
    end)
end

