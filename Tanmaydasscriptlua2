            end)
        end
    end
end)

-- [SECTION 6: EXTRA SENSORY PERCEPTION (ESP) CHANNELS]
local function ApplyESP(object, color, labelText)
    if object:FindFirstChild("SolaraESP") then return end
    local box = Instance.new("Highlight")
    box.Name = "SolaraESP"
    box.FillColor = color
    box.FillTransparency = 0.5
    box.OutlineColor = Color3.fromRGB(255, 255, 255)
    box.Parent = object
end

task.spawn(function()
    while task.wait(3) do
        pcall(function()
            -- Player ESP
            if getgenv().SolaraHub.PlayerESP then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then ApplyESP(p.Character, Color3.fromRGB(255, 0, 0)) end
                end
            end
            -- Fruit ESP
            if getgenv().SolaraHub.FruitESP then
                for _, item in pairs(workspace:GetChildren()) do
                    if item:IsA("Tool") and string.find(item.Name, "Fruit") then ApplyESP(item, Color3.fromRGB(0, 255, 0)) end
                end
            end
        end)
    end
end)

